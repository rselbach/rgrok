[Unit]
Description=rgrok tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rgrok
Group=rgrok
EnvironmentFile=/etc/rgrok/rgrok-server.env
ExecStart=/usr/local/bin/rgrok server --addr 127.0.0.1:7000 --domain rgrok.rselbach.com --scheme https --auth-token ${RGROK_TOKEN}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rgrok

[Install]
WantedBy=multi-user.target
