[Unit]
Description=rgrok tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rgrok
Group=rgrok
EnvironmentFile=/etc/rgrok/rgrok-server.env
ExecStart=/usr/local/bin/rgrok server --addr 127.0.0.1:7000 --domain rgrok.rselbach.com --scheme https --behind-proxy --data /var/lib/rgrok/rgrok.json --github-client-id ${RGROK_GITHUB_CLIENT_ID} --github-client-secret ${RGROK_GITHUB_CLIENT_SECRET}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=rgrok

[Install]
WantedBy=multi-user.target
