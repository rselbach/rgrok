[Unit]
Description=rgrok client tunnel for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/rgrok/rgrok-client@%i.env
ExecStart=/usr/local/bin/rgrok connect ${RGROK_LOCAL_PORT} --server ${RGROK_SERVER} --token ${RGROK_TOKEN} --name ${RGROK_NAME}
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
